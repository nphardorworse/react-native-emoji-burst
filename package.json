{
  "author": "nphardorworse",
  "description": "Performant emoji particle burst animations for React Native, powered by Skia Atlas API",
  "devDependencies": {
    "@shopify/react-native-skia": "^2.5.3",
    "@types/react": "^19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "eslint": "^9.0.0",
    "eslint-plugin-promise": "^7.0.0",
    "eslint-plugin-react": "^7.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "react": "^19.0.0",
    "react-native": "^0.83.0",
    "react-native-builder-bob": "^0.35.0",
    "react-native-reanimated": "^4.2.1",
    "react-native-worklets": "^0.8.1",
    "typescript": "^5.5.0"
  },
  "exports": {
    ".": {
      "react-native": "./lib/module/index.js",
      "default": "./lib/module/index.js",
      "source": "./src/index.tsx",
      "types": "./lib/typescript/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src"
  ],
  "keywords": [
    "react-native",
    "expo",
    "emoji",
    "burst",
    "confetti",
    "particles",
    "animation",
    "skia",
    "reanimated"
  ],
  "license": "MIT",
  "main": "./lib/module/index.js",
  "react-native": "./lib/module/index.js",
  "name": "react-native-emoji-burst",
  "peerDependencies": {
    "@shopify/react-native-skia": ">=2.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.78.0",
    "react-native-reanimated": ">=4.0.0",
    "react-native-worklets": ">=0.8.0"
  },
  "react-native-builder-bob": {
    "output": "lib",
    "source": "src",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      "typescript"
    ]
  },
  "scripts": {
    "clean": "rm -rf lib",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "prepare": "bob build",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nphardorworse/react-native-emoji-burst.git"
  },
  "homepage": "https://github.com/nphardorworse/react-native-emoji-burst#readme",
  "bugs": {
    "url": "https://github.com/nphardorworse/react-native-emoji-burst/issues"
  },
  "types": "./lib/typescript/index.d.ts",
  "version": "0.1.0"
}
